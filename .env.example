# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# PostgreSQL connection string.
# In production use Railway's PRIVATE/internal URL (host ends in .railway.internal)
# so the database is not exposed on the public internet. Only use the public
# "Connect" URL for one-off access from your own machine.
DATABASE_URL=postgresql://user:password@host:port/dbname

# FTP credentials for santacruzclassics.com.
# These also serve as the dashboard login (username + password) for now.
# Must be set on the dashboard web service, not just the fetch job.
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password
